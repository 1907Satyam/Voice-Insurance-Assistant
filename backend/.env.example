# Copy this file to .env and provide the Gnani values from your account.
PROJECT_NAME=Voice Insurance Assistant
DATABASE_URL=sqlite:///./data/insurance_assistant.db
GNANI_API_KEY_ID=
PRISMA_STT_URL=
EVON_LLM_URL=
TIMBRE_TTS_URL=
UPLOAD_DIR=./uploads

# Optional safe local-development settings
EVON_MODEL=
TIMBRE_VOICE=Nalini
TIMBRE_MODEL=timbre-v2.5
CORS_ORIGINS=https://voice-insurance-assistant.vercel.app,http://localhost:5173
MAX_AUDIO_SIZE_MB=15
MAX_DOCUMENT_SIZE_MB=10
